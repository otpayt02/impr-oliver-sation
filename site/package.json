{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && npx wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
